{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2024", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "jsx": "react-jsx",
    "types": [],
    "paths": {
      "cordis": ["../../node_modules/cordis/lib/index.d.ts"]
    }
  },
  "include": [
    "index.ts",
    "editor.ts",
    "view.ts",
    "doc-source.ts",
    "schema/index.ts",
    "serializers/markdown.ts",
    "editor.css.ts",
    "../../src/kernel/contract.ts"
  ]
}
