{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "csp-probe",
  "version": "0.1.0",
  "identifier": "app.selfnotion.cspprobe",
  "build": {
    "frontendDist": "./dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "csp-probe",
        "width": 900,
        "height": 700
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "script-src": "'self'",
        "style-src": "'self' 'unsafe-inline'",
        "img-src": "'self' data: blob: self-notion:",
        "font-src": "'self' data:",
        "connect-src": "'self' ipc: http://ipc.localhost",
        "worker-src": "'self' blob:"
      }
    }
  },
  "bundle": {
    "active": false
  }
}
