{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "dl-probe",
  "version": "0.1.0",
  "identifier": "app.selfnotion.dlprobe",
  "build": {
    "frontendDist": "./dist"
  },
  "app": {
    "windows": [{ "title": "dl-probe", "width": 500, "height": 300 }],
    "security": { "csp": null }
  },
  "plugins": {
    "deep-link": {
      "desktop": { "schemes": ["self-notion"] }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app"],
    "icon": ["icons/icon.png"]
  }
}
