 export const AFFINE_SLASH_MENU_WIDGET = 'affine-slash-menu-widget';
 export const AFFINE_SLASH_MENU_TRIGGER_KEY = '/';
+// self-notion：中文输入法在「中文标点」下按 `/` 打出来的是全角斜杠（U+FF0F），
+// 上游只认半角，于是中文状态下菜单弹不出来。全角也当触发键。
+export const AFFINE_SLASH_MENU_FULLWIDTH_TRIGGER_KEY = '\uff0f';
+export const isSlashMenuTriggerKey = (key: string | null | undefined) =>
+  key === AFFINE_SLASH_MENU_TRIGGER_KEY ||
+  key === AFFINE_SLASH_MENU_FULLWIDTH_TRIGGER_KEY;
+// 输入法直出斜杠时 keydown 报的是 `Process` + `code: 'Slash'`，也是斜杠。
+export const isImeSlashKey = (event: KeyboardEvent) =>
+  event.key === 'Process' && event.code === 'Slash';
 export const AFFINE_SLASH_MENU_TOOLTIP_TIMEOUT = 800;
 export const AFFINE_SLASH_MENU_MAX_HEIGHT = 390;
